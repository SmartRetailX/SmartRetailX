# Copy to .env.production and pass it with:
# docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

COMPOSE_PROJECT_NAME=smart-retail-x
TAG=latest

NODE_ENV=production
LOG_LEVEL=info

POSTGRES_DB=smartretailx
POSTGRES_USER=smartretailx
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smartretailx:change-me-postgres-password@postgres:5432/smartretailx
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

RABBITMQ_DEFAULT_USER=smartretailx
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URI=amqp://smartretailx:change-me-rabbitmq-password@rabbitmq:5672

API_GATEWAY_PORT=3000
API_GATEWAY_HOST=0.0.0.0
BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-production-secret-minimum-32-chars
CORS_ORIGIN=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:3000
WEB_PORT=8080

CORE_SERVICE_QUEUE=core_queue
BI_DASHBOARD_SERVICE_QUEUE=bi_dashboard_queue
WEBSOCKET_SERVICE_QUEUE=websocket_queue
BI_DASHBOARD_PORT=3001
BI_DASHBOARD_HTTP_MODE=false
WEBSOCKET_SERVICE_PORT=3004

ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://bi-dashboard-ml-service:8000
PROMOTION_ENGINE_PORT=8001
PROMOTION_ENGINE_URL=http://promotion-engine:8001
SEGMENTATION_SERVICE_PORT=8002

AGENT_HTTP_PORT=8010
AGENT_TCP_HOST=agent-service
AGENT_TCP_PORT=8877
AGENT_HTTP_VOICE_URL=http://agent-service:8010/api/v1/voice/chat
AGENT_VOICE_TRANSPORT=http-first
AGENT_TCP_TIMEOUT_MS=10000
AGENT_HTTP_TIMEOUT_MS=180000

OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-4o-mini
OPENAI_RESPONSE_TIMEOUT_MS=45000
SINLLAMA_BASE_URL=http://sinlama:8080
SINLLAMA_INTENT_PATH=/api/v1/intent
SINLLAMA_TIMEOUT_MS=8000
SINLLAMA_API_KEY=
SINLLAMA_RETRY_COUNT=1
ASSEMBLYAI_API_KEY=
HF_TOKEN=
STT_AGENT_HOST=0.0.0.0
STT_AGENT_PORT=8003
STT_SAMPLE_RATE=16000
STT_LANGUAGE_CODE=si-LK
STT_ALTERNATIVE_LANGUAGES=en-US
STT_PHRASE_BOOST=20.0
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
