{
  "name": "web",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "web/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project web --web",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "web",
        "command": "rsbuild dev"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "web",
        "command": "rsbuild dev"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "web",
        "command": "rsbuild build"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "web",
        "command": "rsbuild preview"
      }
    }
  }
}