# ==================================
# Client Application Environment Variables
# ==================================
# Copy this file to .env and customize for your environment
# IMPORTANT: Never commit .env files to version control
#
# Note: PUBLIC_ prefix makes variables available in browser
# Variables without PUBLIC_ prefix are build-time only

# ===================================
# Application Metadata
# ===================================
PUBLIC_APP_NAME=SmartRetailX
PUBLIC_APP_VERSION=1.0.0
PUBLIC_APP_ENV=development

# ===================================
# REQUIRED: API Configuration
# ===================================
# Point to your backend API URL (auth-service)
# IMPORTANT: Do NOT include /api or /auth - Better Auth client adds these automatically
# Development: http://localhost:3000
# Production: https://api.yourdomain.com

PUBLIC_API_BASE_URL=http://localhost:3000
PUBLIC_API_TIMEOUT=30000

# ===================================
# REQUIRED: Better Auth Configuration
# ===================================
# Better Auth uses secure HTTP-only cookies for sessions
# No tokens are stored in localStorage for security
# These legacy keys are kept for potential future use

# PUBLIC_AUTH_TOKEN_KEY=smartretailx_auth_token
# PUBLIC_AUTH_REFRESH_TOKEN_KEY=smartretailx_refresh_token

# ===================================
# Feature Flags
# ===================================
# Enable/disable features based on environment

# Enable TanStack Router DevTools
PUBLIC_ENABLE_DEVTOOLS=true

# Enable analytics (set to true in production)
PUBLIC_ENABLE_ANALYTICS=false

# ===================================
# OPTIONAL: External Services
# ===================================
# Uncomment and configure as needed

# Stripe (for payments)
# PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...

# Google Analytics
# PUBLIC_GOOGLE_ANALYTICS_ID=G-...

# Sentry (error tracking)
# PUBLIC_SENTRY_DSN=https://...

# Google OAuth (when implementing social login)
# PUBLIC_GOOGLE_CLIENT_ID=...

# GitHub OAuth (when implementing social login)
# PUBLIC_GITHUB_CLIENT_ID=...

