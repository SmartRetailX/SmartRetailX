# ==================================
# Client Application Environment Variables
# ==================================
# Note: PUBLIC_ prefix makes variables available in browser
# Variables without PUBLIC_ prefix are build-time only
# Copy this file to .env and customize for your environment

# Application Metadata
PUBLIC_APP_NAME=SmartRetailX
PUBLIC_APP_VERSION=1.0.0
PUBLIC_APP_ENV=development

# API Configuration
# Point to your backend API URL
PUBLIC_API_BASE_URL=http://localhost:3000/api
PUBLIC_API_TIMEOUT=30000

# Authentication
# Keys used for storing auth tokens in localStorage
PUBLIC_AUTH_TOKEN_KEY=smartretailx_auth_token
PUBLIC_AUTH_REFRESH_TOKEN_KEY=smartretailx_refresh_token

# Feature Flags
# Enable/disable features based on environment
PUBLIC_ENABLE_DEVTOOLS=true
PUBLIC_ENABLE_ANALYTICS=false

# Optional: External Services
# PUBLIC_STRIPE_PUBLIC_KEY=
# PUBLIC_GOOGLE_ANALYTICS_ID=
# PUBLIC_SENTRY_DSN=

