# ==================================
# SmartRetailX Client Configuration
# ==================================
# Copy this file to .env for local development
# IMPORTANT: Never commit .env files to version control

# ===================================
# API Configuration
# ===================================
# Backend API URL - Better Auth client uses this base URL
# Development: http://localhost:3000
# Production: https://your-api-domain.com

PUBLIC_API_BASE_URL=http://localhost:3000

# ===================================
# OPTIONAL: External Services
# ===================================
# Uncomment and configure as needed

# Stripe (for payments)
# PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...

# Google Analytics
# PUBLIC_GOOGLE_ANALYTICS_ID=G-...

# Sentry (error tracking)
# PUBLIC_SENTRY_DSN=https://...

# Google OAuth (when implementing social login)
# PUBLIC_GOOGLE_CLIENT_ID=...

# GitHub OAuth (when implementing social login)
# PUBLIC_GITHUB_CLIENT_ID=...

