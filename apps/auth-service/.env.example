# ==================================
# Auth Service Environment Variables
# ==================================
# Copy this file to .env and update with your actual values
# IMPORTANT: Never commit .env files to version control

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# ===================================
# REQUIRED: Database Configuration
# ===================================
# Better Auth uses PostgreSQL for storing users, sessions, and accounts
# Format: postgresql://username:password@host:port/database
# 
# Steps to set up:
# 1. Install PostgreSQL: https://www.postgresql.org/download/
# 2. Create database: psql -U postgres -c "CREATE DATABASE smartretailx_auth;"
# 3. Update the credentials below
# 4. Run migrations: psql -U postgres -d smartretailx_auth -f apps/auth-service/migrations/001_init_better_auth.sql

DATABASE_URL=postgresql://postgres:your_password@localhost:5432/smartretailx_auth
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ===================================
# REQUIRED: CORS Configuration
# ===================================
# Must match your client application URL
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# ===================================
# OPTIONAL: Better Auth Configuration
# ===================================
# Base URL for Better Auth (used for email links, redirects)
# In production, set this to your domain (e.g., https://api.smartretailx.com)
BASE_URL=http://localhost:3000

# ===================================
# OPTIONAL: Email Service
# ===================================
# Required for email verification and password reset
# Leave empty to disable email features
# For development, use Mailtrap: https://mailtrap.io
# For production, use SendGrid, AWS SES, or similar

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@smartretailx.com

# ===================================
# OPTIONAL: Logging
# ===================================
LOG_LEVEL=debug

# ===================================
# OPTIONAL: Rate Limiting
# ===================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ===================================
# Legacy JWT Config (Not used by Better Auth)
# ===================================
# Better Auth handles sessions automatically
# These are kept for potential future use
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d
