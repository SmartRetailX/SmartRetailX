// Add these at the TOP of your schema.prisma file:

// ==================== BETTER AUTH TABLES (DO NOT MODIFY) ====================
// These are managed by Better Auth - just declaring them so Prisma doesn't drop them

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("emailVerified")
  image         String?
  role          String   @default("user")
  createdAt     DateTime @default(now()) @map("createdAt")
  updatedAt     DateTime @updatedAt @map("updatedAt")
  
  sessions      Session[]
  accounts      Account[]
  
  @@map("user")
}

model Session {
  id        String   @id
  userId    String   @map("userId")
  token     String   @unique
  expiresAt DateTime @map("expiresAt")
  ipAddress String?  @map("ipAddress")
  userAgent String?  @map("userAgent")
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("session")
}

model Account {
  id           String    @id
  userId       String    @map("userId")
  accountId    String    @map("accountId")
  providerId   String    @map("providerId")
  accessToken  String?   @map("accessToken")
  refreshToken String?   @map("refreshToken")
  idToken      String?   @map("idToken")
  expiresAt    DateTime? @map("expiresAt")
  password     String?
  createdAt    DateTime  @default(now()) @map("createdAt")
  updatedAt    DateTime  @updatedAt @map("updatedAt")
  
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expiresAt")
  createdAt  DateTime @default(now()) @map("createdAt")
  updatedAt  DateTime @updatedAt @map("updatedAt")
  
  @@map("verification")
}

// ==================== YOUR BUSINESS MODELS BELOW ====================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTH ====================
// Better Auth manages: user, session, account, verification tables
// We only store the userId reference (no Prisma relation to Better Auth tables)

model UserStore {
  userId  String
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  @@id([userId, storeId])
  @@map("user_stores")
}

// ==================== STORES ====================
model Store {
  id            String   @id @default(uuid())
  name          String
  nameSi        String?  @map("name_si")
  address       String
  city          String
  phone         String
  manager       String
  active        Boolean  @default(true)
  openingHours  String?  @map("opening_hours")
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  // Relations
  users         UserStore[]
  products      Product[]
  sales         Sale[]
  inventory     InventoryMovement[]
  customers     Customer[]
  promotions    Promotion[]
  alerts        Alert[]
  
  @@map("stores")
}

// ==================== PRODUCTS ====================
model Product {
  id            String    @id @default(uuid())
  sku           String    @unique
  barcode       String?   @unique
  name          String
  nameSi        String?   @map("name_si")
  category      String
  categorySi    String?   @map("category_si")
  price         Float
  cost          Float
  storeId       String    @map("store_id")
  currentStock  Int       @map("current_stock")
  reorderLevel  Int       @map("reorder_level")
  maxStock      Int       @map("max_stock")
  status        StockStatus @default(IN_STOCK)
  supplier      String?
  lastRestocked DateTime? @map("last_restocked")
  expiryDate    DateTime? @map("expiry_date")
  imageUrl      String?   @map("image_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  // Relations
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales         SaleItem[]
  inventory     InventoryMovement[]
  promotions    PromotionProduct[]
  forecasts     Forecast[]
  alerts        Alert[]
  
  @@index([storeId])
  @@index([category])
  @@index([status])
  @@map("products")
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

// ==================== SALES ====================
model Sale {
  id              String   @id @default(uuid())
  transactionId   String   @unique @map("transaction_id")
  storeId         String   @map("store_id")
  customerId      String?  @map("customer_id")
  totalAmount     Float    @map("total_amount")
  discount        Float    @default(0)
  finalAmount     Float    @map("final_amount")
  paymentMethod   PaymentMethod @map("payment_method")
  promotionId     String?  @map("promotion_id")
  timestamp       DateTime @default(now())
  
  // Relations
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  promotion       Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  items           SaleItem[]
  
  @@index([storeId])
  @@index([customerId])
  @@index([timestamp])
  @@map("sales")
}

model SaleItem {
  id         String  @id @default(uuid())
  saleId     String  @map("sale_id")
  productId  String  @map("product_id")
  quantity   Int
  unitPrice  Float   @map("unit_price")
  revenue    Float
  cost       Float
  profit     Float
  
  // Relations
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  BANK_TRANSFER
}

// ==================== INVENTORY ====================
model InventoryMovement {
  id            String         @id @default(uuid())
  productId     String         @map("product_id")
  storeId       String         @map("store_id")
  type          MovementType
  quantity      Int
  previousStock Int            @map("previous_stock")
  newStock      Int            @map("new_stock")
  cost          Float?
  reason        String?
  supplier      String?
  invoiceNumber String?        @map("invoice_number")
  expiryDate    DateTime?      @map("expiry_date")
  userId        String?        @map("user_id")
  timestamp     DateTime       @default(now())
  
  // Relations
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  @@index([productId])
  @@index([storeId])
  @@index([timestamp])
  @@map("inventory_movements")
}

enum MovementType {
  RESTOCK
  SALE
  TRANSFER
  ADJUSTMENT
  WASTE
}

// ==================== FORECASTS ====================
model Forecast {
  id                String   @id @default(uuid())
  productId         String   @map("product_id")
  storeId           String   @map("store_id")
  date              DateTime
  predictedSales    Float    @map("predicted_sales")
  confidenceLower   Float    @map("confidence_lower")
  confidenceUpper   Float    @map("confidence_upper")
  revenue           Float
  modelType         String   @map("model_type")
  confidence        Float
  generatedAt       DateTime @default(now()) @map("generated_at")
  
  // Relations
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([productId, storeId, date])
  @@index([productId])
  @@index([date])
  @@map("forecasts")
}

model ForecastDriver {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  storeId         String   @map("store_id")
  name            String
  nameSi          String?  @map("name_si")
  impact          Float
  description     String
  descriptionSi   String?  @map("description_si")
  generatedAt     DateTime @default(now()) @map("generated_at")
  
  @@index([productId])
  @@map("forecast_drivers")
}

// ==================== CUSTOMERS ====================
model Customer {
  id                String   @id @default(uuid())
  name              String
  email             String?  @unique
  phone             String
  storeId           String   @map("store_id")
  segment           String   @default("new_customers")
  rfmRecency        Int      @default(0) @map("rfm_recency")
  rfmFrequency      Int      @default(0) @map("rfm_frequency")
  rfmMonetary       Int      @default(0) @map("rfm_monetary")
  totalOrders       Int      @default(0) @map("total_orders")
  totalSpent        Float    @default(0) @map("total_spent")
  averageOrderValue Float    @default(0) @map("average_order_value")
  lifetimeValue     Float    @default(0) @map("lifetime_value")
  lastPurchase      DateTime? @map("last_purchase")
  loyaltyCardNumber String?  @unique @map("loyalty_card_number")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  // Relations
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales             Sale[]
  
  @@index([storeId])
  @@index([segment])
  @@map("customers")
}

// ==================== ALERTS ====================
model Alert {
  id                  String      @id @default(uuid())
  type                AlertType
  urgency             Urgency
  productId           String?     @map("product_id")
  storeId             String      @map("store_id")
  currentStock        Int?        @map("current_stock")
  recommendedQuantity Int?        @map("recommended_quantity")
  reason              String
  reasonSi            String?     @map("reason_si")
  confidence          Float
  estimatedStockoutDate DateTime? @map("estimated_stockout_date")
  status              AlertStatus @default(PENDING)
  acceptedAt          DateTime?   @map("accepted_at")
  rejectedAt          DateTime?   @map("rejected_at")
  rejectionReason     String?     @map("rejection_reason")
  purchaseOrderId     String?     @map("purchase_order_id")
  createdAt           DateTime    @default(now()) @map("created_at")
  
  // Relations
  product             Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  store               Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  @@index([storeId])
  @@index([status])
  @@index([urgency])
  @@map("alerts")
}

enum AlertType {
  RESTOCK
  PRICE
  PROMOTION
  QUALITY
}

enum Urgency {
  HIGH
  MEDIUM
  LOW
}

enum AlertStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ==================== PROMOTIONS ====================
model Promotion {
  id              String   @id @default(uuid())
  name            String
  nameSi          String?  @map("name_si")
  storeId         String   @map("store_id")
  discount        Float
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  status          PromotionStatus
  targetedRevenue Float    @map("targeted_revenue")
  actualRevenue   Float    @default(0) @map("actual_revenue")
  lift            Float    @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  
  // Relations
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products        PromotionProduct[]
  sales           Sale[]
  
  @@index([storeId])
  @@index([status])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@id([promotionId, productId])
  @@map("promotion_products")
}

enum PromotionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

// ==================== AUDIT LOGS ====================
model AuditLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id") // References Better Auth's user.id (no Prisma relation)
  action      String
  actionSi    String?  @map("action_si")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  changes     Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  storeId     String?  @map("store_id")
  timestamp   DateTime @default(now())
  
  @@index([userId])
  @@index([entityType])
  @@index([timestamp])
  @@map("audit_logs")
}

// ==================== NOTIFICATIONS ====================
model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") // References Better Auth's user.id (no Prisma relation)
  type      NotificationType
  title     String
  titleSi   String?  @map("title_si")
  message   String
  messageSi String?  @map("message_si")
  actionUrl String?  @map("action_url")
  read      Boolean  @default(false)
  readAt    DateTime? @map("read_at")
  timestamp DateTime @default(now())
  
  @@index([userId])
  @@index([read])
  @@map("notifications")
}

enum NotificationType {
  ALERT
  INFO
  SUCCESS
  WARNING
}