// This schema shares the same PostgreSQL database as the main platform,
// but stores its tables under the bi_dashboard schema.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["bi_dashboard"]
}


// ==================== PRODUCTS ====================
// Aligned with core products schema for easy data sync
model Product {
  // === Core Fields (synced from core.products) ===
  id                String    @id @default(uuid())
  sku               String    @unique
  name              String
  nameSi            String?   @map("name_si")
  description       String?
  descriptionSi     String?   @map("description_si")
  categoryId        String?   @map("category_id")  // Reference to core category, not enforced
  price             Float
  brand             String?
  purchaseFrequency String?   @map("purchase_frequency") // e.g., "high", "medium", "low"
  imageUrl          String?   @map("image_url")
  isActive          Boolean   @default(true) @map("is_active")
  createdBy         String?   @map("created_by")
  
  // === BI-Specific Fields ===
  cost              Float?    // Procurement cost for margin analysis
  currentStock      Int       @default(0) @map("current_stock")
  reorderLevel      Int       @default(0) @map("reorder_level")
  maxStock          Int       @default(0) @map("max_stock")
  status            StockStatus @default(IN_STOCK)
  supplier          String?
  lastRestocked     DateTime? @map("last_restocked")
    competitorPricing Float?    @map("competitor_pricing")  // Market competitive price
  
  // Timestamps
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  
  // Relations
  sales             SaleItem[]
  inventory         InventoryMovement[]
  promotions        PromotionProduct[]
  forecasts         Forecast[]
  alerts            Alert[]
  
  @@index([sku])
  @@index([categoryId])
  @@index([status])
  @@index([isActive])
  @@map("products")
  @@schema("bi_dashboard")
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK

  @@schema("bi_dashboard")
}

// ==================== SALES ====================
model Sale {
  id              String   @id @default(uuid())
  transactionId   String   @unique @map("transaction_id")
  customerId      String?  @map("customer_id")
  totalAmount     Float    @map("total_amount")
  discount        Float    @default(0)
  finalAmount     Float    @map("final_amount")
  paymentMethod   PaymentMethod @map("payment_method")
  promotionId     String?  @map("promotion_id")
  timestamp       DateTime @default(now())
  
  // Relations
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  promotion       Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  items           SaleItem[]
  
  @@index([customerId])
  @@index([timestamp])
  @@map("sales")
  @@schema("bi_dashboard")
}

model SaleItem {
  id         String  @id @default(uuid())
  saleId     String  @map("sale_id")
  productId  String  @map("product_id")
  quantity   Int
  unitPrice  Float   @map("unit_price")
  revenue    Float
  cost       Float
  profit     Float
  
  // Relations
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
  @@schema("bi_dashboard")
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  BANK_TRANSFER

  @@schema("bi_dashboard")
}

// ==================== INVENTORY ====================
model InventoryMovement {
  id            String         @id @default(uuid())
  productId     String         @map("product_id")
  type          MovementType
  quantity      Int
  previousStock Int            @map("previous_stock")
  newStock      Int            @map("new_stock")
  cost          Float?
  reason        String?
  supplier      String?
  invoiceNumber String?        @map("invoice_number")
  expiryDate    DateTime?      @map("expiry_date")
  userId        String?        @map("user_id")
  timestamp     DateTime       @default(now())
  
  // Relations
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([productId])
  @@index([timestamp])
  @@map("inventory_movements")
  @@schema("bi_dashboard")
}

enum MovementType {
  RESTOCK
  SALE
  TRANSFER
  ADJUSTMENT
  WASTE

  @@schema("bi_dashboard")
}

// ==================== FORECASTS ====================
model Forecast {
  id                String   @id @default(uuid())
  productId         String   @map("product_id")
  date              DateTime
  predictedSales    Float    @map("predicted_sales")
  confidenceLower   Float    @map("confidence_lower")
  confidenceUpper   Float    @map("confidence_upper")
  revenue           Float
  modelType         String   @map("model_type")
  confidence        Float
  generatedAt       DateTime @default(now()) @map("generated_at")
  
  // Relations
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([productId, date])
  @@index([productId])
  @@index([date])
  @@map("sales_forecasts")
  @@schema("bi_dashboard")
}

model ForecastDriver {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  name            String
  nameSi          String?  @map("name_si")
  impact          Float
  description     String
  descriptionSi   String?  @map("description_si")
  generatedAt     DateTime @default(now()) @map("generated_at")
  
  @@index([productId])
  @@map("sales_forecast_drivers")
  @@schema("bi_dashboard")
}

// ==================== CUSTOMERS ====================
model Customer {
  id                String   @id @default(uuid())
  name              String
  email             String?  @unique
  phone             String
  segment           String   @default("new_customers")
  rfmRecency        Int      @default(0) @map("rfm_recency")
  rfmFrequency      Int      @default(0) @map("rfm_frequency")
  rfmMonetary       Int      @default(0) @map("rfm_monetary")
  totalOrders       Int      @default(0) @map("total_orders")
  totalSpent        Float    @default(0) @map("total_spent")
  averageOrderValue Float    @default(0) @map("average_order_value")
  lifetimeValue     Float    @default(0) @map("lifetime_value")
  lastPurchase      DateTime? @map("last_purchase")
  loyaltyCardNumber String?  @unique @map("loyalty_card_number")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  // Relations
  sales             Sale[]
  
  @@index([segment])
  @@map("customers")
  @@schema("bi_dashboard")
}

// ==================== ALERTS ====================
model Alert {
  id                  String      @id @default(uuid())
  type                AlertType
  urgency             Urgency
  productId           String?     @map("product_id")
  currentStock        Int?        @map("current_stock")
  recommendedQuantity Int?        @map("recommended_quantity")
  reason              String
  reasonSi            String?     @map("reason_si")
  confidence          Float
  estimatedStockoutDate DateTime? @map("estimated_stockout_date")
  status              AlertStatus @default(PENDING)
  acceptedAt          DateTime?   @map("accepted_at")
  rejectedAt          DateTime?   @map("rejected_at")
  rejectionReason     String?     @map("rejection_reason")
  purchaseOrderId     String?     @map("purchase_order_id")
  createdAt           DateTime    @default(now()) @map("created_at")
  
  // Relations
  product             Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([status])
  @@index([urgency])
  @@map("inventory_alerts")
  @@schema("bi_dashboard")
}

enum AlertType {
  RESTOCK
  PRICE
  PROMOTION
  QUALITY

  @@schema("bi_dashboard")
}

enum Urgency {
  HIGH
  MEDIUM
  LOW

  @@schema("bi_dashboard")
}

enum AlertStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@schema("bi_dashboard")
}

// ==================== PROMOTIONS ====================
model Promotion {
  id              String   @id @default(uuid())
  name            String
  nameSi          String?  @map("name_si")
  discount        Float
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  status          PromotionStatus
  targetedRevenue Float    @map("targeted_revenue")
  actualRevenue   Float    @default(0) @map("actual_revenue")
  lift            Float    @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  
  // Relations
  products        PromotionProduct[]
  sales           Sale[]
  
  @@index([status])
  @@map("promotions")
  @@schema("bi_dashboard")
}

model PromotionProduct {
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@id([promotionId, productId])
  @@map("promotion_products")
  @@schema("bi_dashboard")
}

enum PromotionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED

  @@schema("bi_dashboard")
}

// ==================== AUDIT LOGS ====================
model AuditLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id") // References Better Auth's user.id (no Prisma relation)
  action      String
  actionSi    String?  @map("action_si")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  changes     Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  timestamp   DateTime @default(now())
  
  @@index([userId])
  @@index([entityType])
  @@index([timestamp])
  @@map("audit_logs")
  @@schema("bi_dashboard")
}

// ==================== NOTIFICATIONS ====================
model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") // References Better Auth's user.id (no Prisma relation)
  type      NotificationType
  title     String
  titleSi   String?  @map("title_si")
  message   String
  messageSi String?  @map("message_si")
  actionUrl String?  @map("action_url")
  read      Boolean  @default(false)
  readAt    DateTime? @map("read_at")
  timestamp DateTime @default(now())
  
  @@index([userId])
  @@index([read])
  @@map("notifications")
  @@schema("bi_dashboard")
}

enum NotificationType {
  ALERT
  INFO
  SUCCESS
  WARNING

  @@schema("bi_dashboard")
}
