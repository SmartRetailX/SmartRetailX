  "license": "MIT",
  "scripts": {
    "db:init": "node scripts/bootstrap-databases.mjs",
    "db:init:dry-run": "node scripts/bootstrap-databases.mjs --dry-run",
    "catalog:fuzzy:train": "node scripts/data-insert-scripts/train-product-fuzzy-model.mjs",
    "prisma:generate": "pnpm exec prisma generate --schema libs/database/prisma/schema.prisma",
    "prisma:push": "pnpm exec prisma db push --schema libs/database/prisma/schema.prisma --skip-generate",
    "prisma:studio": "pnpm exec prisma studio --schema libs/database/prisma/schema.prisma",
    "prisma:bi-dashboard:generate": "cd apps/bi-dashboard-services-gateway && npx prisma generate",
    "prisma:bi-dashboard:push": "cd apps/bi-dashboard-services-gateway && npx prisma db push --skip-generate",
    "prisma:bi-dashboard:seed": "cd apps/bi-dashboard-services-gateway && npx tsx prisma/seed.ts",
    "prisma:bi-dashboard:clean": "cd apps/bi-dashboard-services-gateway && npx tsx prisma/clean.ts",
    "prisma:bi-dashboard:reset": "cd apps/bi-dashboard-services-gateway && npx tsx prisma/reset.ts",
    "prisma:bi-dashboard:studio": "cd apps/bi-dashboard-services-gateway && npx prisma studio",
    "biml:setup": "nx run bi-dashboard-ml-service:setup",
    "biml:install": "nx run bi-dashboard-ml-service:install",
    "biml:serve": "nx run bi-dashboard-ml-service:serve",
    "biml:train": "nx run bi-dashboard-ml-service:train",
    "stt:install": "nx run stt-agent:install",
    "stt:serve": "nx run stt-agent:serve",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "dev:frontend": "nx run web:dev",
    "dev:backend": "pnpm db:init && nx run-many --target=serve --projects=bi-dashboard-services-gateway,api-gateway,core-service,websocket-service,agent-service,stt-agent --parallel=6",
    "dev:all": "sh -c 'pnpm dev:backend & pnpm dev:frontend & wait'",
    "dev:ml": "cd apps/personalized-promotion-engine-ml-service && uvicorn api.main:app --host 0.0.0.0 --port 8000 --reload",
    "docker:prod:config": "docker compose --env-file .env.production -f docker-compose.prod.yml config",
    "docker:prod:build": "docker compose --env-file .env.production -f docker-compose.prod.yml build",
    "docker:prod:up": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose --env-file .env.production -f docker-compose.prod.yml down",
    "mobile:start": "nx run mobile-app:start",
    "mobile:android": "nx run mobile-app:start --android",
    "mobile:ios": "nx run mobile-app:start --ios",
    "mobile:web": "nx run mobile-app:start --web",
    "mobile:test": "nx run mobile-app:test",
    "mobile:lint": "nx run mobile-app:lint",
    "mobile:export": "nx run mobile-app:export",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "catalog:aliases:build": "pnpm exec tsx scripts/data-insert-scripts/build-product-aliases.ts"
  },
  "private": true,
