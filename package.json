  "scripts": {
    "prisma:generate": "cd apps/bi-dashboard-services-gateway && npx prisma generate",
    "prisma:push": "cd apps/bi-dashboard-services-gateway && npx prisma db push",
    "prisma:seed": "cd apps/bi-dashboard-services-gateway && npx tsx prisma/seed.ts",
    "prisma:clean": "cd apps/bi-dashboard-services-gateway && npx tsx prisma/clean.ts",
    "prisma:reset": "cd apps/bi-dashboard-services-gateway && npx tsx prisma/reset.ts",
    "prisma:studio": "cd apps/bi-dashboard-services-gateway && npx prisma studio",
    "biml:setup": "nx run bi-dashboard-ml-service:setup",
    "biml:install": "nx run bi-dashboard-ml-service:install",
    "biml:serve": "nx run bi-dashboard-ml-service:serve",
    "biml:train": "nx run bi-dashboard-ml-service:train",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "dev:frontend": "nx run-many --target=serve --projects=client --parallel=1",
    "dev:backend": "nx run-many --target=serve --projects=bi-dashboard-services-gateway,api-gateway,core-service --parallel=3",
    "dev:all": "nx run-many --target=serve --projects=bi-dashboard-services-gateway,api-gateway,core-service,client --parallel=4",
    "mobile:start": "nx run mobile-app:start",
    "mobile:android": "nx run mobile-app:start --android",
    "mobile:ios": "nx run mobile-app:start --ios",
    "mobile:web": "nx run mobile-app:start --web",
    "mobile:test": "nx run mobile-app:test",
    "mobile:lint": "nx run mobile-app:lint",
    "mobile:export": "nx run mobile-app:export",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
