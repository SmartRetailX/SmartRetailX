# SmartRetailX Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# Global Configuration
# ============================================
NODE_ENV=development

# ============================================
# API Gateway Service
# ============================================
API_GATEWAY_PORT=3000
VITE_API_BASE_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# Use 0.0.0.0 to allow connections from network (mobile devices, other computers)
# Use localhost for local-only access (more secure but mobile won't work)
API_GATEWAY_HOST=0.0.0.0

# ============================================
# PostgreSQL Database
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/smartretailx?sslmode=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# Authentication (JWT)
# ============================================
# IMPORTANT: Change these to strong secrets (minimum 32 characters)
JWT_SECRET=change-me-to-a-secure-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=change-me-to-another-secure-secret-minimum-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins for CORS
# Examples:
#   - Single origin: http://localhost:5173
#   - Multiple origins: http://localhost:5173,https://yourapp.com
#   - Allow all (dev only): *
# Note: Mobile apps are automatically allowed (they don't send Origin header)
CORS_ORIGIN=http://localhost:5173,*

# ============================================
# Voice Assistant Configuration (Core Service)
# ============================================
# AssemblyAI Configuration
# Get your API key from: https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ============================================
# Agent Service (Whisper + OpenAI Response)
# ============================================
# API Gateway TCP client target (Nest Transport.TCP)
AGENT_TCP_HOST=127.0.0.1
AGENT_TCP_PORT=8877

# Agent service HTTP settings
AGENT_HTTP_PORT=8010
AGENT_HTTP_VOICE_URL=http://127.0.0.1:8010/api/v1/voice/chat
AGENT_VOICE_TRANSPORT=http-first
AGENT_TCP_TIMEOUT_MS=10000
AGENT_HTTP_TIMEOUT_MS=180000

# OpenAI STT (required)
OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-4o-mini
OPENAI_RESPONSE_TIMEOUT_MS=45000

# ============================================
# RabbitMQ Message Queue
# ============================================
# Full connection URI (includes host, port, user, password)
RABBITMQ_URI=amqp://guest:guest@localhost:5672

# ============================================
# BI Dashboard Service
# ============================================
# Port for BI Dashboard Service (when in HTTP mode)
BI_DASHBOARD_PORT=3001
# Enable HTTP mode for development (allows access to API docs at /docs)
# Set to 'false' in production (pure microservice mode via RabbitMQ)
BI_DASHBOARD_HTTP_MODE=true

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# Production (Optional)
# ============================================
# BASE_URL=https://your-production-domain.com

# ============================================
# Nx Cloud (Optional)
# ============================================
# NX_CLOUD_ACCESS_TOKEN=
