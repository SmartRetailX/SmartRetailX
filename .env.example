# SmartRetailX — copy to .env and fill in your values

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── API Gateway ───────────────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
# 0.0.0.0 = network-accessible; localhost = local-only
API_GATEWAY_HOST=0.0.0.0
# Leave empty to auto-resolve from request host
PUBLIC_BASE_URL=
# Leave empty to auto-resolve from request host
PUBLIC_WEBSOCKET_URL=
CORS_ORIGIN=http://localhost:5173,*
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/smartretailx?sslmode=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Authentication (Better Auth) ──────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-minimum-32-chars
BETTER_AUTH_URL=http://localhost:3000

# ── Message Queue (RabbitMQ) ──────────────────────────────────────────────────
RABBITMQ_URI=amqp://guest:guest@localhost:5672
CORE_SERVICE_QUEUE=core_queue
BI_DASHBOARD_SERVICE_QUEUE=bi_dashboard_queue
WEBSOCKET_SERVICE_QUEUE=websocket_queue
CORE_ORDER_TIMEOUT_MS=3000
CORE_CATALOG_TIMEOUT_MS=3000

# ── WebSocket Service ─────────────────────────────────────────────────────────
WEBSOCKET_SERVICE_PORT=3004
AGENT_HTTP_VOICE_URL=http://127.0.0.1:8010/api/v1/voice/chat  # Agent service — STT + intent + response
API_GATEWAY_VOICE_URL=http://127.0.0.1:3000/api/v1/voice      # API Gateway — persist chat to DB

# ── Agent Service ─────────────────────────────────────────────────────────────
AGENT_HTTP_PORT=8010
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_RESPONSE_MODEL=gpt-4o-mini
OPENAI_RESPONSE_TIMEOUT_MS=45000
OPENAI_TRANSLATION_MODEL=gpt-4o-mini

# ── SinLlama (Sinhala intent detection) ──────────────────────────────────────
# Dev (same-host): http://127.0.0.1:8080  |  Prod (Docker): http://sinlama:8080
SINLLAMA_BASE_URL=http://127.0.0.1:8080
SINLLAMA_INTENT_PATH=/api/v1/intent
SINLLAMA_API_KEY=
SINLLAMA_TIMEOUT_MS=8000
SINLLAMA_RETRY_COUNT=1

# ── STT Agent (Google Cloud Speech) ──────────────────────────────────────────
STT_AGENT_HOST=0.0.0.0
STT_AGENT_PORT=8003
STT_LANGUAGE_CODE=si-LK
STT_ALTERNATIVE_LANGUAGES=en-US
STT_SAMPLE_RATE=16000
STT_PHRASE_BOOST=20.0
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Agent STT provider ────────────────────────────────────────────────────────
# "hybrid" = Google Cloud STT first, falls back to OpenAI Whisper on failure
# "stt-agent" = Google Cloud STT only  |  "openai" = OpenAI Whisper only
STT_PROVIDER=hybrid
STT_AGENT_HTTP_URL=http://127.0.0.1:8003/api/v1/stt/transcribe
STT_AGENT_TIMEOUT_MS=60000

# ── Cloudinary (audio storage) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# ── BI Dashboard & ML Service ─────────────────────────────────────────────────
BI_DASHBOARD_PORT=3001
BI_DASHBOARD_HTTP_MODE=true     # true = HTTP mode with /docs; false = RabbitMQ-only
ML_SERVICE_URL=http://localhost:8000
PROMOTION_ENGINE_URL=http://localhost:8000
