# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Environment variables
.env
.env.*
.env.local
.env.*.local
!.env.example
!.env.*.example
credentials.txt
*.session.sql
apps/**/.git/

# Prisma generated clients
apps/api-gateway/src/generated/prisma/
apps/core-service/src/generated/prisma/

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Markdown files
!README.md
!SETUP.md
*.md

# Expo
node_modules/
.expo/
.yarn/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
cache/


apps/mobile-app-e2e/artifacts


# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
dist/
build/
node_modules/
node_modules

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/

# Data files (large CSVs)
data/raw/*.csv
data/processed/*.csv

# Trained models (large files)
models/*.pkl
models/*.h5
models/*.joblib

# Evaluation outputs
evaluation/results/*.png
evaluation/results/*.jpg
evaluation/results/*.pdf

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log

# Keep folder structure but ignore contents
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!evaluation/results/.gitkeep

# Allow specific files
!ASSISTANT_TEST_PLAN.md
!REMOTE_DEPLOY.md

.copilotignore
.codexignore

# Script related files
scripts/data-insert-scripts/all_products.json
scripts/data-insert-scripts/prompt.txt
!scripts/README.md
.claude